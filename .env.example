# Local commercial demo defaults. Copy to .env for local Docker or dev-commercial runs.
# For production, keep the same keys but inject real secrets from the deployment platform.
APP_ENV="development"
NODE_ENV="development"
DATABASE_URL="postgresql://oa:oa_dev_password@127.0.0.1:5432/oa_commercial?schema=public"
POSTGRES_SERVICE="postgres"
POSTGRES_DB="oa_commercial"
POSTGRES_USER="oa"
POSTGRES_PASSWORD="oa_dev_password"
SERVER_HOST="127.0.0.1"
SERVER_PORT="8787"
JWT_SECRET="local-commercial-demo-secret-change-before-production-20260530"
JWT_EXPIRES_IN="8h"
COOKIE_NAME="oa_session"
COOKIE_MAX_AGE_SECONDS="28800"
AUTH_FAILED_LOGIN_LIMIT="5"
AUTH_FAILED_LOGIN_WINDOW_MS="600000"
AUTH_FAILED_LOGIN_MAX_KEYS="10000"
FILE_STORAGE_DRIVER="local"
FILE_STORAGE_DIR=".local-files"
BACKUP_DIR="backups/postgres"
OBJECT_STORAGE_ENDPOINT=""
OBJECT_STORAGE_BUCKET=""
OBJECT_STORAGE_REGION=""
OBJECT_STORAGE_ACCESS_KEY_ID=""
OBJECT_STORAGE_SECRET_ACCESS_KEY=""
OBJECT_STORAGE_PREFIX=""
OBJECT_STORAGE_FORCE_PATH_STYLE="1"
FILE_MAX_UPLOAD_BYTES="5242880"
IMPORT_MAX_HTML_BYTES="10485760"
API_BODY_LIMIT_BYTES="10551296"
FILE_BACKUP_DIR="backups/files"
FILE_BACKUP_USE_LOCAL="1"
PRUNE_DATABASE_KEEP="14"
PRUNE_FILE_KEEP="14"
DEFAULT_TENANT_CODE="default"
DEFAULT_ADMIN_EMAIL="admin@oa.local"
DEFAULT_ADMIN_PASSWORD="admin123456"
WEB_ORIGIN="http://127.0.0.1:8080,http://localhost:8080,http://127.0.0.1:5173,http://127.0.0.1:5174"
TRUST_PROXY="0"
API_BASE_URL="http://127.0.0.1:8787"
VITE_REQUIRE_API="1"
VITE_DEMO_FALLBACK="0"
RUN_DB_SEED="1"
