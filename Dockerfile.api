FROM node:22-alpine

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY prisma ./prisma
RUN npm run db:generate

ENV NODE_ENV=production

COPY server ./server
COPY scripts ./scripts
COPY oa-dashboard.html ./oa-dashboard.html

RUN chmod +x scripts/docker-api-entrypoint.sh

EXPOSE 8787

CMD ["sh", "scripts/docker-api-entrypoint.sh"]
