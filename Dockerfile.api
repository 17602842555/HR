FROM node:22-alpine

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY prisma ./prisma
RUN npm run db:generate

ENV NODE_ENV=production

COPY server ./server
COPY scripts ./scripts
COPY oa-dashboard.html ./oa-dashboard.html

RUN mkdir -p /app/storage/files \
  && chmod +x scripts/docker-api-entrypoint.sh \
  && chown -R node:node /app

USER node

EXPOSE 8787

CMD ["sh", "scripts/docker-api-entrypoint.sh"]
